# Optional: run without Docker. Install with:
#   sudo cp deploy/vmt.service /etc/systemd/system/ && sudo systemctl enable --now vmt
[Unit]
Description=Voicemail Translator
After=network-online.target
Wants=network-online.target

[Service]
User=vmt
WorkingDirectory=/opt/voicemail-translator
ExecStart=/opt/voicemail-translator/.venv/bin/vmt run
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
